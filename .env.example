# Copy to .env.production on the VPS (never commit the real file).

# Public address of the site. Used for canonical links, Open Graph tags and the sitemap.
SITE_URL=https://www.your-domain.com

# Keep "false" until the launch is approved. "false" adds noindex and blocks crawlers in robots.txt.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact form delivery (SMTP)
CONTACT_TO=inquiries@your-domain.com
CONTACT_FROM=Liquid Legacy Website <no-reply@your-domain.com>
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
# Prefer 465 with SMTP_SECURE=true (TLS from the first byte). With 587/false the app still requires STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Local development only: "1" logs inquiries to the server console instead of sending email.
CONTACT_DRY_RUN=0

# Shared secret proving a request came through Nginx; must match the X-LLD-Proxy header in deploy/nginx.conf.example.
PROXY_SECRET=

# Mockup/demo only: the form shows success but nothing is sent. Never set on the real launch.
CONTACT_DEMO_MODE=0
