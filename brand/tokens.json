{
  "$description": "Liquid Legacy Distribution brand tokens. Gold values are sampled from the supplied crest (brand/source/lld-logo-original.png). Contrast ratios are WCAG 2.x against the named background.",
  "color": {
    "obsidian": {
      "hex": "#12110F",
      "rgb": "18 17 15",
      "cmyk": "0 6 17 93",
      "role": "Primary background"
    },
    "coal": {
      "hex": "#1B1A17",
      "rgb": "27 26 23",
      "cmyk": "0 4 15 89",
      "role": "Raised surfaces, cards, footer"
    },
    "char": {
      "hex": "#24221E",
      "rgb": "36 34 30",
      "cmyk": "0 6 17 86",
      "role": "Borders on dark, inputs"
    },
    "gold": {
      "hex": "#BF9F66",
      "rgb": "191 159 102",
      "cmyk": "0 17 47 25",
      "role": "Primary accent: rules, labels, buttons",
      "contrast": {
        "obsidian": 7.52
      }
    },
    "gilt": {
      "hex": "#E6D3A3",
      "rgb": "230 211 163",
      "cmyk": "0 8 29 10",
      "role": "Highlights and hover",
      "contrast": {
        "obsidian": 12.77
      }
    },
    "bronze": {
      "hex": "#755D45",
      "rgb": "117 93 69",
      "cmyk": "0 21 41 54",
      "role": "Hairlines and secondary rules (decorative only)",
      "contrast": {
        "obsidian": 3.06
      }
    },
    "goldDeep": {
      "hex": "#7A5C30",
      "rgb": "122 92 48",
      "cmyk": "0 25 61 52",
      "role": "Gold for text on parchment",
      "contrast": {
        "parchment": 5.06
      }
    },
    "parchment": {
      "hex": "#EFE8DA",
      "rgb": "239 232 218",
      "cmyk": "0 3 9 6",
      "role": "Light sections, text on dark",
      "contrast": {
        "obsidian": 15.48
      }
    },
    "stone": {
      "hex": "#A8A093",
      "rgb": "168 160 147",
      "cmyk": "0 5 13 34",
      "role": "Muted text on dark",
      "contrast": {
        "obsidian": 7.29
      }
    },
    "ink": {
      "hex": "#1A1815",
      "rgb": "26 24 21",
      "cmyk": "0 8 19 90",
      "role": "Text on parchment",
      "contrast": {
        "parchment": 14.53
      }
    },
    "inkMuted": {
      "hex": "#5A5347",
      "rgb": "90 83 71",
      "cmyk": "0 8 21 65",
      "role": "Muted text on parchment",
      "contrast": {
        "parchment": 6.23
      }
    },
    "error": {
      "hex": "#E39A8B",
      "rgb": "227 154 139",
      "role": "Form errors on dark (about 8:1 on char)"
    }
  },
  "font": {
    "serif": {
      "family": "Libre Caslon Display",
      "use": "Large headlines (h1, h2). One weight (400); never bolded.",
      "weights": [
        400
      ]
    },
    "serifText": {
      "family": "Libre Caslon Text",
      "use": "Smaller headings (h3, h4), pull quotes, italics",
      "weights": [
        400,
        700
      ],
      "italic": true
    },
    "sans": {
      "family": "Libre Franklin",
      "use": "Body copy, navigation, buttons, forms, captions. Sentence case, no spaced capitals.",
      "weights": [
        400,
        500,
        600
      ]
    },
    "logo": {
      "family": "Official crest lettering (artwork)",
      "use": "Only inside the logo. Never retyped."
    },
    "rationale": "Caslon set America's founding documents; Franklin Gothic is the classic American sans. Both come from American printing, fitting a national distributor named Legacy."
  },
  "radius": {
    "default": "2px"
  },
  "motion": {
    "reveal": "transform only, 400ms max, disabled under prefers-reduced-motion"
  }
}
